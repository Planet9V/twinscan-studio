FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    libglib2.0-0 \
    libgl1 \
    libgomp1 \
    curl \
    openssh-client \
    espeak-ng \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt /app/requirements.txt
RUN pip install --upgrade pip && pip install -r /app/requirements.txt
# Optional C++ accelerated GICP registration (graceful fallback built into src/lidar/registration.py)
RUN pip install small-gicp || true

COPY pyproject.toml /app/pyproject.toml
COPY src /app/src
COPY tests /app/tests
COPY docs /app/docs

RUN mkdir -p /app/data/uploads

EXPOSE 8000

CMD ["uvicorn", "src.app.factory:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000"]
